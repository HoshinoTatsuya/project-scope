{
  "name": "@hoshinotatsuya/project-scope",
  "version": "0.3.2",
  "description": "Data isolation by scope (project, tenant, organization) on PostgreSQL row-level security as a second line of defence behind WHERE: migration policies that fail closed without a context, transaction-only context, a startup readiness check of the catalog and a coverage gate for schema and migrations.",
  "keywords": [
    "postgres",
    "postgresql",
    "row-level-security",
    "rls",
    "multi-tenant",
    "tenant-isolation",
    "drizzle",
    "migrations",
    "security"
  ],
  "license": "MIT",
  "author": "Hoshino_Tatsuya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoshinoTatsuya/project-scope.git"
  },
  "homepage": "https://github.com/HoshinoTatsuya/project-scope#readme",
  "bugs": {
    "url": "https://github.com/HoshinoTatsuya/project-scope/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./gate": {
      "import": {
        "types": "./dist/gate.d.mts",
        "default": "./dist/gate.js"
      },
      "require": {
        "types": "./dist/gate.d.ts",
        "default": "./dist/gate.js"
      }
    },
    "./gate/jest": {
      "import": {
        "types": "./dist/gate-jest.d.mts",
        "default": "./dist/gate-jest.js"
      },
      "require": {
        "types": "./dist/gate-jest.d.ts",
        "default": "./dist/gate-jest.js"
      }
    },
    "./drizzle": {
      "import": {
        "types": "./dist/drizzle.d.mts",
        "default": "./dist/drizzle.js"
      },
      "require": {
        "types": "./dist/drizzle.d.ts",
        "default": "./dist/drizzle.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "gate": [
        "./dist/gate.d.ts"
      ],
      "gate/jest": [
        "./dist/gate-jest.d.ts"
      ],
      "drizzle": [
        "./dist/drizzle.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node scripts/emit-esm-types.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json && node scripts/check-readme-examples.cjs",
    "lint": "biome check src",
    "test": "scripts/with-postgres.sh jest-groups --out .jest-report.json -- node_modules/.bin/jest && jest-assert-no-skipped .jest-report.json",
    "test:consumers": "scripts/consumer-matrix.sh",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run test:replica && pnpm run test:pgbouncer && pnpm run test:consumers && pnpm run build",
    "test:replica": "scripts/with-replica.sh jest-groups --out .jest-replica-report.json -- node_modules/.bin/jest --config jest.replica.config.js && jest-assert-no-skipped .jest-replica-report.json",
    "test:pgbouncer": "scripts/with-pgbouncer.sh jest-groups --out .jest-pgbouncer-report.json -- node_modules/.bin/jest --config jest.pgbouncer.config.js && jest-assert-no-skipped .jest-pgbouncer-report.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@jest/globals": ">=29",
    "@hoshinotatsuya/pg-runtime": "^0.7.1 || ^0.8.0 || ^0.9.0",
    "@types/pg": ">=8.15.0",
    "drizzle-orm": ">=0.45.2 <0.46",
    "pg": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "@jest/globals": {
      "optional": true
    },
    "@types/pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@jest/globals": "30.5.2",
    "@hoshinotatsuya/arch-gates": "^0.12.2",
    "@hoshinotatsuya/fault-kit": "^0.3.1",
    "@hoshinotatsuya/jest-groups": "^0.7.2",
    "@hoshinotatsuya/pg-runtime": "0.9.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.0.15",
    "@types/pg": "8.23.1",
    "drizzle-orm": "0.45.2",
    "jest": "30.5.2",
    "pg": "8.18.0",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3"
  }
}
